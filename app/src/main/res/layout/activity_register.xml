<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Márgenes laterales de 32dp -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="32dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="32dp" />

    <!-- Título -->
    <TextView
        style="@style/titulo"
        android:id="@+id/tvTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="Registro"
        app:layout_constraintEnd_toEndOf="@id/glEnd"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Email -->
    <TextView
        android:id="@+id/tvEmailLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Email"
        android:textColor="#DDDDDD"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo" />

    <EditText
        android:id="@+id/etEmail"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@android:color/transparent"
        android:hint="ejemplo@correo.com"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="4dp"
        android:textColor="@color/texto_1"
        android:textColorHint="@color/texto_sub"
        app:layout_constraintEnd_toEndOf="@id/glEnd"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/tvEmailLabel" />

    <View
        android:id="@+id/lineaEmail"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/fondo_3"
        app:layout_constraintEnd_toEndOf="@id/glEnd"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/etEmail" />

    <!-- Contraseña -->
    <TextView
        android:id="@+id/tvPasswordLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Contraseña"
        android:textColor="#DDDDDD"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/lineaEmail" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@android:color/transparent"
        android:hint="Contraseña"
        android:inputType="textPassword"
        android:paddingHorizontal="4dp"
        android:textColor="@color/texto_1"
        android:textColorHint="@color/texto_sub"
        app:layout_constraintEnd_toEndOf="@id/glEnd"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/tvPasswordLabel" />

    <View
        android:id="@+id/lineaPassword"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/fondo_3"
        app:layout_constraintEnd_toEndOf="@id/glEnd"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/etPassword" />

    <!-- Nombre de usuario -->
    <TextView
        android:id="@+id/tvUserLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Nombre de usuario"
        android:textColor="#DDDDDD"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/lineaPassword" />

    <EditText
        android:id="@+id/etUser"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@android:color/transparent"
        android:hint="Nombre de usuario"
        android:inputType="textPersonName"
        android:paddingHorizontal="4dp"
        android:textColor="@color/texto_1"
        android:textColorHint="@color/texto_sub"
        app:layout_constraintEnd_toEndOf="@id/glEnd"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/tvUserLabel" />

    <View
        android:id="@+id/lineaUser"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/fondo_3"
        app:layout_constraintEnd_toEndOf="@id/glEnd"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/etUser" />

    <!-- Botones de abajo -->

    <Button
        android:id="@+id/btnRegister"
        style="@style/boton_1"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:text="Registrarse"
        android:textAllCaps="false"
        app:layout_constraintBottom_toTopOf="@id/btnGoLogin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        style="@style/boton_2"
        android:id="@+id/btnGoLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="52dp"
        android:text="¿Ya tienes cuenta? Pulsa aquí"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>