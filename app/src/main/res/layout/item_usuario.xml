<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/texto_cajas" />

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/icono_usuario"
        app:tint="@color/fondo_3" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icono_flecha_arriba"
            app:tint="@color/fondo_3" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="20dp"
            android:layout_marginTop="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icono_flecha_abajo"
            app:tint="@color/fondo_3" />
    </LinearLayout>

    <ImageButton
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:background="@android:color/transparent"
        android:contentDescription="Eliminar usuario"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/icono_papelera"
        app:tint="@color/fondo_3" />
</LinearLayout>